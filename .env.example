# OJAMS Environment Configuration Template
# Copy this file to .env and fill in your values.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ojams_db
DB_USER=root
DB_PASS=

APP_NAME=OJAMS
BASE_URL=http://localhost/OJAMS

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME="OJAMS Notifications"
 
# PhilSMS API Configuration
PHILSMS_API_URL=https://dashboard.philsms.com/api/v3/sms/send
PHILSMS_API_TOKEN=your_philsms_api_token
PHILSMS_SENDER_ID=PhilSMS
