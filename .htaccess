# ============================================================
# OJAMS — Apache Configuration
# ============================================================

Options -Indexes
DirectoryIndex index.php

# ── HTTPS Enforcement ────────────────────────────────────────
# Redirect all HTTP traffic to HTTPS in production.
# Skipped on localhost so local XAMPP development is unaffected.
# ────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Skip redirect for localhost, 127.0.0.1, and private LAN IPs (dev/testing environments)
    RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$
    RewriteCond %{HTTP_HOST} !^192\.168\.
    RewriteCond %{HTTP_HOST} !^10\.
    RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[0-1])\.
    RewriteCond %{HTTP_HOST} !^::1$

    # Only redirect if not already on HTTPS
    RewriteCond %{HTTPS} off

    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Security Headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent browsers from MIME-sniffing the content type
    Header always set X-Content-Type-Options "nosniff"

    # Block clickjacking — page cannot be embedded in an iframe
    Header always set X-Frame-Options "DENY"

    # Enable XSS filter in older browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Enforce HTTPS for 1 year once on HTTPS (production only)
    # mod_rewrite above already skips localhost, so this is safe
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Control referrer info sent to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Basic Content Security Policy
    # Allows Bootstrap/Google Fonts CDNs used throughout the app
    Header always set Content-Security-Policy "default-src 'self'; \
script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; \
style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; \
font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; \
img-src 'self' data:; \
connect-src 'self' https://cdn.jsdelivr.net;"
</IfModule>

# ── Custom Error Pages ──────────────────────────────────────
# Adjust the leading path if the app is deployed at domain root (remove /OJAMS).
ErrorDocument 400 /OJAMS/error.php?code=400
ErrorDocument 403 /OJAMS/error.php?code=403
ErrorDocument 404 /OJAMS/404.php
ErrorDocument 405 /OJAMS/error.php?code=405
ErrorDocument 500 /OJAMS/error.php?code=500
ErrorDocument 503 /OJAMS/error.php?code=503

# ── PHP Error Display ────────────────────────────────────────
# Hide raw PHP errors from end users in production.
# Remove or invert these two lines during local development.
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# ── Protect Sensitive Files ──────────────────────────────────
# Block direct browser access to config, logs, and .env.
<FilesMatch "\.(env|log|sql|md|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block .htaccess itself from being read directly
<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
